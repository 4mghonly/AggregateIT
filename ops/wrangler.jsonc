{
  "name": "aggregateit-cadence",
  "main": "scheduler.mjs",
  "compatibility_date": "2026-10-14",
  "workers_dev": false,
  "triggers": {"crons": ["*/5 * * * *"]},
  "durable_objects": {"bindings": [{"name": "CADENCE", "class_name": "Cadence"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Cadence"]}]
}
